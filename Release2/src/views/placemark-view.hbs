{{> menu active="placemarks"}}

<section class="section">
  <div class="container">
    <h1 class="title">Your Coffee Placemarks</h1>

    {{#if error}}
      <div class="notification is-danger">{{error}}</div>
    {{/if}}

    <form action="/placemarks/add" method="POST" class="box">
      <h2 class="subtitle">Add a New Placemark</h2>

      <div class="field">
        <label class="label">Name</label>
        <input class="input" type="text" name="name" required />
      </div>

      <div class="field">
        <label class="label">Description</label>
        <input class="input" type="text" name="description" required />
      </div>

      <div class="field">
        <label class="label">Location</label>
        <input class="input" type="text" name="location" required />
      </div>

      <button class="button is-primary" type="submit">Add Placemark</button>
    </form>

    <hr />

    <h2 class="subtitle">Your Placemarks</h2>

    <table class="table is-fullwidth is-striped">
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Location</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        {{#each placemarks}}
          <tr>
            <td>{{name}}</td>
            <td>{{description}}</td>
            <td>{{location}}</td>
            <td>
              <a class="button is-danger is-small" href="/placemarks/delete/{{_id}}">
                Delete
              </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>

  </div>
</section>
